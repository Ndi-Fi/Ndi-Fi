# Ndi-Fi environment variables.
# Copy to .env and fill in values. Never commit .env.
#
# Every variable read by code (Solidity scripts, shell scripts, web app) must be
# listed here. Variables marked "required" must also be in .github/env/required.txt.
# CI (.github/workflows/env-check.yml) enforces both rules.

# --- Solidity / Foundry (script/DeployNdiPoint.s.sol) ---
# required: deployer private key used by `forge script`.
PRIVATE_KEY=

# --- Stellar testnet deploy (stellar/scripts/deploy_testnet.sh) ---
# All optional; the script has defaults.
STELLAR_IDENTITY=ndi-deployer
LENDING_ASSET_ID=
LP_TOKEN_ID=
DEPOSIT_CAP=
INTEREST_RATE=500000
REWARD_RATE=1000000
MIN_STAKE=
MAX_STAKE=
COOLDOWN_SECONDS=1814400
