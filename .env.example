# Ndi-Fi environment variables.
# Copy to .env and fill in values. Never commit .env.
#
# Every variable read by code (Solidity scripts, shell scripts, web app) must be
# listed here. Variables marked "required" must also be in .github/env/required.txt.
# CI (.github/workflows/env-check.yml) enforces both rules.

# --- Solidity / Foundry (script/DeployNdiPoint.s.sol) ---
# required: deployer private key used by `forge script`.
PRIVATE_KEY=

# --- Stellar testnet deploy (stellar/scripts/deploy_testnet.sh) ---
# All optional; the script has defaults.
STELLAR_IDENTITY=ndi-deployer
LENDING_ASSET_ID=
LP_TOKEN_ID=
DEPOSIT_CAP=
INTEREST_RATE=500000
REWARD_RATE=1000000
MIN_STAKE=
MAX_STAKE=
COOLDOWN_SECONDS=1814400

# --- Web client (web/config/client-config.js) ---
# Public EVM configuration. NEXT_PUBLIC_* values are embedded in client bundles;
# use public RPC endpoints only and never put private keys or secrets here.
NEXT_PUBLIC_MAINNET_CHAIN_ID=1
NEXT_PUBLIC_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
NEXT_PUBLIC_MAINNET_NDI_POINT_ADDRESS=
NEXT_PUBLIC_MAINNET_NDI_FI_VAULT_ADDRESS=
NEXT_PUBLIC_MAINNET_NDI_FI_LENDING_ADDRESS=
NEXT_PUBLIC_MAINNET_NDI_STAKING_ADDRESS=

NEXT_PUBLIC_TESTNET_CHAIN_ID=11155111
NEXT_PUBLIC_TESTNET_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_TESTNET_NDI_POINT_ADDRESS=
NEXT_PUBLIC_TESTNET_NDI_FI_VAULT_ADDRESS=
NEXT_PUBLIC_TESTNET_NDI_FI_LENDING_ADDRESS=
NEXT_PUBLIC_TESTNET_NDI_STAKING_ADDRESS=

# --- Local dev stack (scripts/dev-local.sh, frontend/scripts/serve.js) ---
# All optional; defaults shown.
ANVIL_PORT=8545
PORT_FRONTEND=8080
PORT_WEB=8000
# Port for the frontend demo server when run on its own.
PORT=8080
# Set to 1 to skip a part of the local stack.
SKIP_STELLAR=0
SKIP_EVM=0
SKIP_FRONTEND=0
SKIP_WEB=0
