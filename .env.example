# ============================================================
# Ndi-Fi environment variable template
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file containing real secrets.
# See docs/Environment.md for full documentation.
# ============================================================

# ------------------------------------------------------------------
# Solidity / Foundry stack
# ------------------------------------------------------------------

# Deployer private key (required for forge script deployments)
PRIVATE_KEY=

# JSON-RPC endpoint for the target EVM network
RPC_URL=

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=

# ERC-20 address of the vault's underlying asset (DAI or mock)
DAI_TOKEN_ADDRESS=

# Address that will own the deployed Solidity contracts
INITIAL_OWNER=

# --- NdiFiLending ---

# Chainlink AggregatorV3Interface address for DAI/USD
LENDING_TOKEN_PRICE_FEED=

# Maximum LTV percentage at loan origination (0-100)
COLLATERAL_FACTOR=75

# LTV percentage at which a loan becomes liquidatable (> COLLATERAL_FACTOR)
LIQUIDATION_THRESHOLD=85

# One-time origination fee in basis points (max 1000 = 10%)
ORIGINATION_FEE_RATE=50

# Extra collateral seized as penalty on liquidation, in basis points (max 2000 = 20%)
LIQUIDATION_PENALTY=500

# --- NdiStaking (Solidity) ---

# ERC-20 address of the token users stake (must equal DAI_TOKEN_ADDRESS)
STAKE_TOKEN_ADDRESS=

# ERC-20 address of the reward token (NdiPoint)
REWARD_TOKEN_ADDRESS=

# Annual percentage yield paid to stakers (whole number, e.g. 15 = 15%)
APY=15

# Minimum stake in wei (default: 10 tokens with 18 decimals)
MIN_STAKE=10000000000000000000

# Maximum stake in wei (default: 1000 tokens with 18 decimals)
MAX_STAKE=1000000000000000000000

# Minimum staking duration in seconds before withdrawal can be requested
MIN_DURATION=1728000

# ------------------------------------------------------------------
# Stellar / Soroban stack
# ------------------------------------------------------------------

# Stellar deployer secret key (S...)
STELLAR_SECRET_KEY=

# Target Stellar network: testnet | mainnet | local
STELLAR_NETWORK=testnet

# Soroban RPC endpoint
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase (must match STELLAR_NETWORK)
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Owner addresses for each Soroban contract
NDI_TOKEN_OWNER=
NDI_LENDING_OWNER=
NDI_STAKING_OWNER=

# SEP-41 asset contract used as the lending vault's underlying asset
VAULT_ASSET_ADDRESS=

# SEP-41 LP token address staked in NdiStaking
LP_TOKEN_ADDRESS=

# Deployed NdiToken contract address (reward token for staking)
REWARD_TOKEN_ADDRESS=

# Lending vault deposit cap (i128, in token stroops)
DEPOSIT_CAP=

# Borrower annual interest rate scaled by 1e7 (10000000 = 100% APR)
INTEREST_RATE=500000

# Staker annual reward rate scaled by 1e7 (10000000 = 100% APR)
REWARD_RATE=1500000

# Min/max stake amounts in token stroops (7 decimals)
MIN_STAKE_STELLAR=10000000
MAX_STAKE_STELLAR=1000000000000

# Cooldown between request_unstake and unstake, in seconds (default: 21 days)
COOLDOWN=1814400
